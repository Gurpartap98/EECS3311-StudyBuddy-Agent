# Copy this file to .env and fill in local values. Never commit .env.
# Prefer a free/cheap HTTP LLM for demos (Groq / Gemini / OpenRouter).

# Which LLM strategy to use: groq | gemini | openrouter | ollama
LLM_PROVIDER=groq

# Cloud provider key (only the provider you choose needs a key)
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional model override (provider-specific defaults apply if empty)
LLM_MODEL=

# Local Ollama (optional). Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Where StudyBuddy stores courses, materials, and progress
STUDYBUDDY_DATA_DIR=./data
